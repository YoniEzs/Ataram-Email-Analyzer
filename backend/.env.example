# Copy this file to .env and fill in your values

# Security (REQUIRED in production — change from default)
SECRET_KEY=change-this-to-a-random-secret-key

# API Keys (optional — enables richer analysis)
ABUSEIPDB_KEY=
VIRUSTOTAL_API_KEY=

# Server
HOST=0.0.0.0
PORT=5000

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=http://localhost:3000,https://ataram.uk

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per hour

# Shared storage (recommended in production with >1 worker).
# Point at Redis to share rate-limit counters and lookup caches across
# workers; leave empty for per-process in-memory storage.
# REDIS_URL is used for both unless the specific vars are set.
REDIS_URL=
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# CACHE_REDIS_URL=redis://localhost:6379/1

# Timeouts (seconds)
DNS_TIMEOUT=5
WHOIS_TIMEOUT=10
HTTP_TIMEOUT=10

# Feature flags
ENABLE_WHOIS=true
ENABLE_ABUSEIPDB=true
# VirusTotal attachment-hash lookups (requires VIRUSTOTAL_API_KEY or BYOK)
ENABLE_VIRUSTOTAL=false
# Independent SPF/DKIM verification instead of trusting header claims
ENABLE_AUTH_VERIFICATION=true

# Trusted domains (optional, comma-separated). Leave empty unless you control it.
# Trust reduces risk; it never suppresses other suspicious signals.
WHITELIST_DOMAINS=

# YARA rules directory (leave blank to disable)
YARA_RULES_PATH=yara_rules

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Logs go to stdout by default; set true to also write logs/email_analyzer.log
LOG_TO_FILE=false
