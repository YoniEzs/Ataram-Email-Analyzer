# Copy this file to .env and fill in your values

# Security — optional: the API is stateless (no sessions/CSRF), so an
# ephemeral key is generated when unset. Set explicitly if session-based
# features are ever added: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# API Keys (optional — enables richer analysis)
ABUSEIPDB_KEY=
VIRUSTOTAL_API_KEY=

# Server
HOST=0.0.0.0
PORT=5000

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=http://localhost:3000

# Number of controlled reverse proxies whose X-Forwarded-* headers are trusted.
# Keep 0 for a directly exposed dev server; Docker Compose and Render use 1.
TRUST_PROXY_COUNT=0

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per hour

# Shared storage (recommended in production with >1 worker).
# Point at Redis to share rate-limit counters and lookup caches across
# workers; leave empty for per-process in-memory storage.
# REDIS_URL is used for both unless the specific vars are set.
REDIS_URL=
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# CACHE_REDIS_URL=redis://localhost:6379/1

# Timeouts (seconds)
DNS_TIMEOUT=5
WHOIS_TIMEOUT=10
HTTP_TIMEOUT=10

# Feature flags
ENABLE_WHOIS=true
ENABLE_ABUSEIPDB=true
# VirusTotal attachment-hash lookups (requires VIRUSTOTAL_API_KEY or BYOK)
ENABLE_VIRUSTOTAL=false
# Independent DKIM verification. SPF/DMARC header claims remain untrusted.
ENABLE_AUTH_VERIFICATION=true

# Artifact enrichment (see PRIVACY.md - these disclose the sending IP to
# third-party DNS and RDAP services).
# Reverse DNS (PTR) plus forward confirmation of the sending IP.
ENABLE_REVERSE_DNS=true
# Registry network object for the sending IP (rdap.org).
ENABLE_IP_RDAP=true
# Announcing ASN and BGP prefix for the sending IP (Team Cymru, DNS only).
ENABLE_ASN_LOOKUP=true
# MX records for the sender domain.
ENABLE_MX_LOOKUP=false
# Advisory SPF re-evaluation. Off by default: the client IP and MAIL FROM are
# read from forgeable headers, so the result is display-only and never scored.
ENABLE_SPF_ADVISORY=false
SPF_TIMEOUT=8

# Trusted domains (optional, comma-separated). Leave empty unless you control it.
# Trust reduces risk; it never suppresses other suspicious signals.
WHITELIST_DOMAINS=

# YARA rules directory (leave blank to disable)
YARA_RULES_PATH=yara_rules

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Logs go to stdout by default; set true to also write logs/email_analyzer.log
LOG_TO_FILE=false

# Hostile-input resource bounds (bytes unless stated otherwise)
MAX_UPLOAD_BYTES=26214400
MAX_MIME_PARTS=250
MAX_ATTACHMENTS=100
MAX_ATTACHMENT_BYTES=10485760
MAX_TOTAL_ATTACHMENT_BYTES=20971520
MAX_TEXT_CHARS=2000000
MAX_URLS=500
MAX_URL_LENGTH=4096
MAX_YARA_SCAN_BYTES=8388608
MAX_ARCHIVE_MEMBERS=100
MAX_ARCHIVE_UNCOMPRESSED_BYTES=209715200
MAX_ARCHIVE_RATIO=100
