# Copy to .env on the deploy host and fill in.
# Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Startup aborts if SECRET_KEY is empty, shorter than 32 characters, or left as
# the development placeholder — the container will not come up with a weak key.

SECRET_KEY=

# Optional API keys — enable richer analysis when present.
# Read from here only; a key supplied by a client is ignored by design.
ABUSEIPDB_KEY=
VIRUSTOTAL_API_KEY=

# Same-origin behind nginx, so no cross-origin request is ever made and CORS is
# unused. Left empty deliberately: an empty list disables CORS entirely rather
# than advertising an allowed origin that nothing needs. "*" is rejected.
CORS_ORIGINS=

# cloudflared -> nginx -> gunicorn. The app sees nginx: one hop it may trust.
# Raising this lets clients spoof X-Forwarded-For and evade rate limiting.
TRUSTED_PROXY_COUNT=1

RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_ANALYZE=10 per minute;60 per hour
RATELIMIT_URL=50 per minute;500 per hour
RATELIMIT_LOOKUP=30 per minute;300 per hour
# In-memory limits are per-worker, so the 4-worker deployment enforces roughly
# 4x the configured rate. Add a Redis service and set this for a real limit.
# docker-compose.yml runs a Redis service and sets this, so limits hold across
# all four gunicorn workers instead of being enforced per-process.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# The frontend never calls /api/analyze/url, /api/check/domain or /api/check/ip.
# Each turns a cheap unauthenticated request into DNS, WHOIS or third-party API
# traffic from this host. Keep them off.
ENABLE_UTILITY_ENDPOINTS=false

# Parse-time guards. These bound work done BEFORE analysis begins: Python's
# email parser is super-linear in header tokens, so one crafted header in a
# 1.5MB file cost ~237s of CPU and killed a worker.
MAX_HEADER_BLOCK_BYTES=262144
MAX_HEADER_LINE_BYTES=16384
MAX_HEADER_COUNT=500
MAX_MIME_PARTS=1000

# Kept in sync with client_max_body_size in nginx.conf.
MAX_UPLOAD_MB=25
MAX_ANALYZED_BODY_CHARS=2097152
MAX_ANALYZED_HTML_CHARS=1048576
MAX_ANALYZED_URLS=500
MAX_ANALYZED_ATTACHMENTS=100
MAX_ANALYZED_HOPS=100
MAX_HOP_CHARS=4096
CACHE_MAX_ENTRIES=5000

DNS_TIMEOUT=3
WHOIS_TIMEOUT=5
HTTP_TIMEOUT=5
# Total budget for all outbound lookups in one analyze request.
LOOKUP_BUDGET_SECONDS=8

ENABLE_WHOIS=true
ENABLE_ABUSEIPDB=true
ENABLE_VIRUSTOTAL=false

# nginx also sets HSTS; the backend sets it on API responses.
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000

# REPORTED ONLY — this list no longer affects the risk score. The cap it used to
# apply was removed: every input gating it was attacker-chosen (see
# ataram-backend/.env.example for the full reasoning).
WHITELIST_DOMAINS=microsoft.com,google.com,amazon.com,apple.com,linkedin.com,facebook.com

YARA_RULES_PATH=yara_rules
LOG_LEVEL=INFO
LOG_TO_STDOUT=true
