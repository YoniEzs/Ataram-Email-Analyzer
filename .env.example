# Environment variables for Docker Compose
# Copy this file to .env and fill in your values

# Optional while the API remains stateless.
SECRET_KEY=

# API Keys (optional — enables richer analysis)
ABUSEIPDB_KEY=
VIRUSTOTAL_API_KEY=

# CORS (origins allowed to call the API)
CORS_ORIGINS=http://localhost:3000

# Feature toggles
ENABLE_WHOIS=true
ENABLE_ABUSEIPDB=true
ENABLE_VIRUSTOTAL=false
# Independent DKIM verification. SPF/DMARC are shown as forgeable claims only.
ENABLE_AUTH_VERIFICATION=true

# Artifact enrichment (see PRIVACY.md - these disclose the sending IP to
# third-party DNS and RDAP services).
# Reverse DNS (PTR) plus forward confirmation of the sending IP.
ENABLE_REVERSE_DNS=true
# Registry network object for the sending IP (rdap.org).
ENABLE_IP_RDAP=true
# Announcing ASN and BGP prefix for the sending IP (Team Cymru, DNS only).
ENABLE_ASN_LOOKUP=true
# MX records for the sender domain.
ENABLE_MX_LOOKUP=false
# Advisory SPF re-evaluation. Off by default: the client IP and MAIL FROM are
# read from forgeable headers, so the result is display-only and never scored.
ENABLE_SPF_ADVISORY=false

# Lookup timeouts (seconds).
DNS_TIMEOUT=5
WHOIS_TIMEOUT=10
HTTP_TIMEOUT=10
SPF_TIMEOUT=8

# Trusted sender domains (comma-separated). Empty by default; only discounts
# otherwise low-risk mail and never suppresses high-risk evidence.
WHITELIST_DOMAINS=
