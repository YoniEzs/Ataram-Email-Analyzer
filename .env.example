# Copy this file to .env and fill in your values

# --- Security -------------------------------------------------------------
# REQUIRED when FLASK_ENV is anything other than "development". Startup aborts
# if this is missing, shorter than 32 characters, or left as the dev placeholder.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# API Keys (optional — enables richer analysis)
# The AbuseIPDB key is read from here only. A key supplied by a client in a
# request body is ignored by design.
ABUSEIPDB_KEY=
VIRUSTOTAL_API_KEY=

# Server
HOST=0.0.0.0
PORT=5000

# --- Reverse proxy --------------------------------------------------------
# Number of proxy hops in front of the app whose X-Forwarded-For may be trusted.
# The reference deployment is cloudflared -> nginx -> gunicorn, so the app sees
# nginx: one trusted hop.
#
# Getting this wrong breaks rate limiting in one of two ways:
#   too low  -> every request keys on the proxy's IP, so the whole internet
#               shares one bucket and one abuser locks out everybody
#   too high -> a client can prepend its own X-Forwarded-For and mint a fresh
#               bucket per request, evading limits entirely
# Set to 0 when the app is exposed directly with no proxy.
TRUSTED_PROXY_COUNT=1

# --- CORS -----------------------------------------------------------------
# Comma-separated origins allowed to call the API. Leave EMPTY for the
# single-origin production deployment (nginx serves the frontend and proxies
# /api, so no cross-origin request is ever made). "*" is rejected at startup.
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting --------------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_ANALYZE=10 per minute;60 per hour
RATELIMIT_URL=50 per minute;500 per hour
RATELIMIT_LOOKUP=30 per minute;300 per hour

# Limiter storage. The default is per-process, so with 4 gunicorn workers each
# limit is enforced roughly 4x too loosely and resets on restart. For a limit
# that actually holds, run Redis and point this at it:
#   RATELIMIT_STORAGE_URI=redis://redis:6379/0
RATELIMIT_STORAGE_URI=memory://

# --- Attack surface -------------------------------------------------------
# /api/analyze/url, /api/check/domain and /api/check/ip are not used by the
# frontend. Each turns a cheap unauthenticated request into DNS, WHOIS or
# third-party API traffic originating from this server. Leave false unless
# something actually consumes them.
ENABLE_UTILITY_ENDPOINTS=false

# --- Parse-time limits ----------------------------------------------------
# These matter MORE than the analysis limits below, because they bound work
# that happens before analysis begins. Python's email package parses header
# values lazily and super-linearly: one crafted To: header in a 1.5MB file cost
# ~237s of CPU and killed the worker. The guard runs on raw bytes, because once
# a header value has been read the cost has already been paid.
MAX_HEADER_BLOCK_BYTES=262144
MAX_HEADER_LINE_BYTES=16384
MAX_HEADER_COUNT=500
MAX_MIME_PARTS=1000

# --- Analysis limits ------------------------------------------------------
MAX_UPLOAD_MB=25
# Bound the CPU one upload can consume. Without these a 50MB email body is fed
# whole to the HTML parser and a dozen regex passes.
MAX_ANALYZED_BODY_CHARS=2097152
MAX_ANALYZED_HTML_CHARS=1048576
MAX_ANALYZED_URLS=500
MAX_ANALYZED_ATTACHMENTS=100
MAX_ANALYZED_HOPS=100
MAX_HOP_CHARS=4096
# Ceiling on the in-process DNS/WHOIS/IP cache, which is keyed by untrusted input.
CACHE_MAX_ENTRIES=5000

# --- Timeouts (seconds) ---------------------------------------------------
# Each of these blocks a whole sync worker against a host named by the uploaded
# email, so they are deliberately short.
DNS_TIMEOUT=3
WHOIS_TIMEOUT=5
HTTP_TIMEOUT=5
# Total wall-clock budget for ALL outbound lookups in one /api/analyze request.
# Once spent, enrichment is abandoned and the result is marked
# lookups_truncated rather than silently looking clean. Four sync workers cannot
# absorb ten concurrent requests that each block for half a minute.
LOOKUP_BUDGET_SECONDS=8

# --- Feature flags --------------------------------------------------------
ENABLE_WHOIS=true
ENABLE_ABUSEIPDB=true
ENABLE_VIRUSTOTAL=false

# --- Security headers -----------------------------------------------------
# HSTS is hard to undo once a browser has cached it, so it is opt-in. Enable it
# only when the site is served over HTTPS on every path.
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
# The policy names no third-party origin: the Google Fonts webfont was removed
# in favour of the system font stack, which also stopped every anonymous page
# load disclosing the visitor's IP to Google. Adding an origin back here widens
# the CSP — do it deliberately or not at all.
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_FONT_SRC='self'

# Trusted sender domains. REPORTED ONLY — this list no longer affects the risk
# score in any way. A From domain appearing here sets
# risk_assessment.sender_domain_is_trusted in the JSON and nothing else.
#
# It used to cap the score at "low". That was removed because every input
# gating it is chosen by the attacker: the From header is unauthenticated, and
# the SPF result came from an Authentication-Results header inside the uploaded
# file. Requiring DNS-verified SPF+DMARC did not help either — those are looked
# up for the SPOOFED domain, and every brand worth impersonating publishes both.
# A signal that can only ever LOWER risk, and that an attacker can switch on at
# will, is worse than no signal.
#
# Adding entries here is therefore harmless, and also does nothing.
WHITELIST_DOMAINS=microsoft.com,google.com,amazon.com,apple.com,linkedin.com,facebook.com

# YARA rules directory (leave blank to disable)
YARA_RULES_PATH=yara_rules

# --- Logging --------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log to stdout so the container runtime collects it and the root filesystem can
# stay read-only.
LOG_TO_STDOUT=true
